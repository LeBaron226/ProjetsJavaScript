function sanitizeLog(entry, disallowedCharacters) {
  let result = entry;

  for (let ent of entry) {
    for (let dis of disallowedCharacters) {
      if (ent === dis) {
        result = result.slice(0, result.indexOf(ent)) + "#" + result.slice(result.indexOf(ent) + 1);
      };
    };
  };

  return result;
};

