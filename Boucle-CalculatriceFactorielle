function fact(num) {
  let newNum = 1
  for (num ;num > 0 ;num--) {
    newNum = newNum * num
  }
  return newNum;
};
console.log(fact(4))

// Code officiel.

let num1 = 10;
function factorialCalculator(numb) {
  let result = 1;
  for (let nu = 1; nu <= numb; nu++) {
    result = result * nu
  };
  return result;
};

let factorial1 = factorialCalculator(num1);
const resultMsg = `Factorial of ${num1} is ${factorial1}`;
console.log(resultMsg);

